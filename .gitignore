# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Release 建置產物（build-release.sh 輸出的 .app / .dmg）
/dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude framework
__pycache__/
coverage/
htmlcov/
.claude/hook-logs/
.claude/hooks/hook-logs/
.claude/skills/*/hook-logs/
.claude/worktrees/
.claude/tool-results/
.claude/handoff/
.claude/dispatch-active
.claude/dispatch-active.json
.claude/dispatch-active.lock
.claude/hook-state/
.claude/state/
.claude/logs/
.claude/pm-status.json
.claude/ARCHITECTURE_REVIEW_REQUIRED
.claude/PM_INTERVENTION_REQUIRED
.claude/TASK_AVOIDANCE_FIX_MODE
*.md.lock
.claude/scheduled_tasks.lock
# ticket CLI 建立 ticket 時的併發鎖（runtime 產物，會落在 tickets/ 目錄下）
# 不可用 *.lock 概括，那會誤擋必須進版控的 pubspec.lock
.ticket-create.lock

# 測試副作用洩漏：mock 物件被當路徑使用時生成的字面目錄（純垃圾）
**/MagicMock/

# .claude runtime state 與 local-only 產物
# 來源：sync_exclude_manifest.GITIGNORE_EXPECTED（push 端 clean-check 會把未列入者判為未追蹤而 abort）
# 背景：PC-019 死循環——commit 後 AUQ 觸發 hook 寫入 runtime state，被 git tracked 即造成
#      dirty tree，阻擋 worktree fork
.claude/.pytest_cache
.claude/.sync-conflicts
.claude/.sync-state.json
.claude/.venv
.claude/.version-release.yaml
.claude/.zhtw-mcp-skip
.claude/analyses
.claude/migration-backups
.claude/plans
.claude/settings.local.json
.claude/sync-preserve.yaml
.claude/sync-skills.yaml
